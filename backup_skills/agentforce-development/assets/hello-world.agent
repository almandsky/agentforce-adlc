# Hello World Agent
# The minimal viable Agentforce agent — start here.
#
# This template shows the minimum structure for a deployable service agent.
# All indentation uses TABS (required by the Agent Script compiler).
#
# Deploy with:
#   sf agent publish authoring-bundle --api-name HelloWorldAgent -o <org-alias> --json
#   sf agent activate --api-name HelloWorldAgent -o <org-alias>

config:
	developer_name: "HelloWorldAgent"
	agent_label: "Hello World Agent"
	description: "A minimal example agent to learn Agent Script basics"
	default_agent_user: "einsteinagent@00dxx000001234.ext"

variables:
	EndUserId: linked string
		source: @MessagingSession.MessagingEndUserId
		description: "Messaging End User ID"
		visibility: "External"
	RoutableId: linked string
		source: @MessagingSession.Id
		description: "Messaging Session ID"
		visibility: "External"
	ContactId: linked string
		source: @MessagingEndUser.ContactId
		description: "Contact ID"
		visibility: "External"

system:
	instructions: |
		You are an AI assistant. Greet users warmly and help them.
		If you cannot help, offer to connect them with a human agent.
	messages:
		welcome: "Hello! I'm here to help. What can I do for you today?"
		error: "I'm sorry, something went wrong. Please try again."

language:
	default_locale: "en_US"
	additional_locales: ""
	all_additional_locales: False

start_agent topic_selector:
	description: "Route user requests"
	reasoning:
		instructions: |
			You are a router only. Do NOT answer questions or provide help directly.
			Always use a transition action to route to the greeting topic immediately.
		actions:
			to_greeting: @utils.transition to @topic.greeting
				description: "Greet the user and provide help"

topic greeting:
	label: "Greeting"
	description: "Greet users and provide general help"
	reasoning:
		instructions: |
			Welcome the user warmly.
			Ask how you can help them today.
			Be friendly and conversational.
		actions:
			escalate_now: @utils.escalate
				description: "Transfer to human agent"
